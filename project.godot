; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Ambidextro"
run/main_scene="res://scenes/main/main_scene.tscn"
config/use_custom_user_dir=true
config/features=PackedStringArray("4.3", "Mobile")
run/max_fps=240
boot_splash/show_image=false
config/icon="res://assets/sprites/icon/application_icon.png"
config/macos_native_icon="res://assets/sprites/icon/application_icon_mac.icns"
config/windows_native_icon="res://assets/sprites/icon/application_icon.ico"
run/vsync/vsync_mode=1

[audio]

buses/default_bus_layout="res://audio_bus_layout.tres"

[autoload]

Global="*res://scripts/global.gd"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/unassigned_variable=0
gdscript/warnings/unassigned_variable_op_assign=0
gdscript/warnings/unused_parameter=0

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3

[editor_plugins]

enabled=PackedStringArray("res://addons/kanban_tasks/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg")

