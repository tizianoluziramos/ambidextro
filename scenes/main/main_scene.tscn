[node name="MusicPlayerB" type="AudioStreamPlayer" parent="AudioPlayers/MusicController"]
bus = &"Music"

[node name="MusicPlayerLayers1" type="AudioStreamPlayer" parent="AudioPlayers/MusicController"]
stream = SubResource("AudioStreamSynchronized_8g72e")
bus = &"Music"

[node name="MusicPlayerLayers2" type="AudioStreamPlayer" parent="AudioPlayers/MusicController"]
stream = SubResource("AudioStreamSynchronized_s8vi2")
bus = &"Music"

[node name="Layer0Timer" type="Timer" parent="AudioPlayers/MusicController"]
wait_time = 11.0
one_shot = true

[node name="LayerChangeTimer" type="Timer" parent="AudioPlayers/MusicController"]
wait_time = 2.5
one_shot = true

[node name="WinPlayer" type="AudioStreamPlayer" parent="AudioPlayers"]
stream = ExtResource("74")
volume_db = 5.0
bus = &"SFX"

[node name="ResetPlayer" type="AudioStreamPlayer" parent="AudioPlayers"]
stream = ExtResource("75")
volume_db = -5.0
bus = &"SFX"

[node name="ChangeLevel" type="AudioStreamPlayer" parent="AudioPlayers"]
stream = ExtResource("76")
bus = &"LevelChange"

[node name="UISounds" type="Node" parent="AudioPlayers" node_paths=PackedStringArray("ui_players")]
script = ExtResource("77")
ui_players = [NodePath("UI1"), NodePath("UI2")]
accept_sound = ExtResource("78")
back_sound = ExtResource("79")
selection_sound = ExtResource("80")
lateral_sound = ExtResource("81")
invalid_sound = ExtResource("82")
remap_sound = ExtResource("83")
key_sound = ExtResource("84")

[node name="UI1" type="AudioStreamPlayer" parent="AudioPlayers/UISounds"]
process_mode = 3
bus = &"SFX"

[node name="UI2" type="AudioStreamPlayer" parent="AudioPlayers/UISounds"]
process_mode = 3
bus = &"SFX"

[node name="CRTShader" type="ColorRect" parent="."]
process_mode = 3
material = ExtResource("85")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("86")
